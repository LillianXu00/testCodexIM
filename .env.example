# Enrollment permission; identities get their own community credentials.
COMMUNITY_JOIN_TOKEN=replace-with-enrollment-secret
COMMUNITY_READ_TOKEN=replace-with-query-secret
CENTRAL_URL=http://127.0.0.1:8000
AGENT_ENDPOINT=http://127.0.0.1:9100
AGORA_DATA_DIR=.runtime/central
# Gateway or SDK/CLI calls MemOS directly; central does not need this key.
MEMOS_API_KEY=
MEMOS_SPACE_ID=agora-shared
MEMOS_BASE_URL=https://memos.memtensor.cn/api/openmem/v1
